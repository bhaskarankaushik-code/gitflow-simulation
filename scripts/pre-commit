#!/usr/bin/env bash
# Pre-commit hook: block direct commits to main/master, then lint and test.
set -e

branch="$(git rev-parse --abbrev-ref HEAD)"

# Allow merge commits (e.g. release/hotfix merges into main) to pass the branch guard.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  is_merge=1
else
  is_merge=0
fi

if { [ "$branch" = "main" ] || [ "$branch" = "master" ]; } && [ "$is_merge" -eq 0 ]; then
  echo "pre-commit: direct commits to '$branch' are not allowed."
  echo "            Use a feature/*, release/* or hotfix/* branch and merge."
  exit 1
fi

echo "pre-commit: running flake8..."
python3 -m flake8 src tests --max-line-length=100

echo "pre-commit: running tests..."
python3 -m pytest -q

echo "pre-commit: all checks passed."
